{
  "name": "fivethreeone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm run --filter @fivethreeone/frontend dev",
    "dev:worker": "pnpm run --filter @fivethreeone/worker dev",
    "build": "pnpm run --recursive build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "preview": "pnpm run --filter @fivethreeone/frontend preview",
    "deploy": "pnpm run build && pnpm run --filter @fivethreeone/worker deploy",
    "cf-typegen": "pnpm run --filter @fivethreeone/worker cf-typegen"
  },
  "devDependencies": {
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2"
  }
}
