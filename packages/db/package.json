{
  "name": "@fivethreeone/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "node --import tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "db:drop": "node --import tsx ./node_modules/drizzle-kit/bin.cjs drop",
    "db:push": "node --import tsx ./node_modules/drizzle-kit/bin.cjs push",
    "db:check": "node --import tsx ./node_modules/drizzle-kit/bin.cjs check",
    "db:up": "node --import tsx ./node_modules/drizzle-kit/bin.cjs up"
  },
  "dependencies": {
    "@fivethreeone/shared": "workspace:*",
    "drizzle-orm": "^0.43.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.6",
    "tsx": "^4.23.1"
  }
}
